{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "chatbot_id": { "type": "string" },
    "visitor_id": { "type": "string" },
    "messages": { "type": "array", "items": { "type": "object" } },
    "satisfaction_rating": { "type": "number" },
    "status": { "type": "string", "enum": ["active","closed"], "default": "active" }
  },
  "required": ["chatbot_id"]
}
